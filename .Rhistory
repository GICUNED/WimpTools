var A_ext={x:A.x-dx*endPad, y:A.y-dy*endPad}, B_ext={x:B.x+dx*endPad, y:B.y+dy*endPad};
var A1={x:A_ext.x+nx*r,y:A_ext.y+ny*r}, B1={x:B_ext.x+nx*r,y:B_ext.y+ny*r};
var A2={x:A_ext.x-nx*r,y:A_ext.y-ny*r}, B2={x:B_ext.x-nx*r,y:B_ext.y-ny*r};
beginStyle(ctx, styles.fill, styles.stroke, styles.lw);
ctx.beginPath();
ctx.moveTo(A1.x,A1.y); ctx.lineTo(B1.x,B1.y);
ctx.arc(B_ext.x,B_ext.y,r,Math.atan2(ny,nx),Math.atan2(-ny,-nx));
ctx.lineTo(A2.x,A2.y);
ctx.arc(A_ext.x,A_ext.y,r,Math.atan2(-ny,-nx),Math.atan2(ny,nx));
ctx.closePath(); ctx.fill(); ctx.stroke(); endStyle(ctx);
}
function drawElongatedIfNeeded(ctx, pts, styles){
var ax=pcaAxis(pts), v=ax.dir, c=ax.center;
var projs=pts.map(function(p){ return (p.x-c.x)*v.x + (p.y-c.y)*v.y; });
var minT=Math.min.apply(null,projs), maxT=Math.max.apply(null,projs);
var length=maxT-minT;
var widths=pts.map(function(p){
var t=(p.x-c.x)*v.x+(p.y-c.y)*v.y;
var px=c.x+t*v.x, py=c.y+t*v.y;
return Math.hypot(p.x-px,p.y-py);
});
var halfW=Math.max.apply(null,widths);
var elongated = length > 3*Math.max(halfW,1);
if(!elongated) return false;
var A={x:c.x+v.x*minT, y:c.y+v.y*minT};
var B={x:c.x+v.x*maxT, y:c.y+v.y*maxT};
var side = halfW + PAD_SIDE;
var end  = Math.min(PAD_SIDE, Math.max(6, 0.15*length)); // **acotado**
drawCapsule(ctx, A, B, side, end, styles);
// etiqueta (rectángulo aproximado)
var ort={x:-v.y,y:v.x};
var ptsLab=[{x:A.x+ort.x*side,y:A.y+ort.y*side},{x:B.x+ort.x*side,y:B.y+ort.y*side},
{x:B.x-ort.x*side,y:B.y-ort.y*side},{x:A.x-ort.x*side,y:A.y-ort.y*side}];
drawLabel(ctx, ptsLab, styles.label, styles.fill);
return true;
}
// Colores por grupo
var colorMap={
'A': {fill:'rgba(110,168,254,0.15)', stroke:'rgba(110,168,254,0.65)', lw:LINE_W, label:'A'},
'B': {fill:'rgba(114,214,160,0.15)', stroke:'rgba(114,214,160,0.65)', lw:LINE_W, label:'B'},
'C': {fill:'rgba(247,178,103,0.15)', stroke:'rgba(247,178,103,0.65)', lw:LINE_W, label:'C'},
'D': {fill:'rgba(217,133,185,0.15)', stroke:'rgba(217,133,185,0.65)', lw:LINE_W, label:'D'}
};
// === Dibujo por grupo ===
var groups=uniqueGroups();
groups.forEach(function(g){
var ids=net.body.data.nodes.getIds({filter:function(n){return n.group===g;}});
if(!ids || ids.length===0) return;
var pos=net.getPositions(ids);
var pts=ids.map(function(id){ return {x:pos[id].x, y:pos[id].y}; });
var styles=colorMap[g] || {fill:'rgba(120,120,120,0.12)', stroke:'rgba(120,120,120,0.55)', lw:LINE_W, label:g};
// 1–2 nodos → cápsula corta
if(pts.length<=2){
var A=pts[0], B=(pts.length===2?pts[1]:{x:pts[0].x+1,y:pts[0].y});
drawCapsule(ctx, A, B, PAD_SIDE, Math.max(6, Math.min(PAD_SIDE, 20)), styles);
drawLabel(ctx, [A,B], styles.label, styles.fill);
return;
}
// ¿alargado? → cápsula; si no, offset convexo redondeado
if (drawElongatedIfNeeded(ctx, pts, styles)) return;
var hull=convexHull(pts);
var off=offsetConvex(hull, PAD_SIDE);
drawRounded(ctx, off, CORNER_R, styles);
drawLabel(ctx, off, styles.label, styles.fill);
});
}
"
# Dibuja debajo de todo
visNetwork(nodes, edges, width='100%', height='640px') |>
visOptions(highlightNearest=TRUE, nodesIdSelection=TRUE) |>
visInteraction(dragNodes=TRUE, dragView=TRUE, zoomView=TRUE) |>
visPhysics(stabilization=TRUE) |>
visEvents(beforeDrawing = js_hulls)
wimp <- importwimp(file.choose())
View(wimp)
View(wimp)
wimp[["self"]]
wimp[["constructs"]][["categorie"]][["Categoria"]]
# install.packages("visNetwork")
library(visNetwork)
# ===== Datos de ejemplo "casi reales" =====
set.seed(3)
# Grupos: A (6 nodos, alargado), B (4 nodos), C (2 nodos), D (1 nodo)
nodes <- rbind(
data.frame(id = 1:6,  label = paste0("A", 1:6), group = "A"),
data.frame(id = 7:10, label = paste0("B", 1:4), group = "B"),
data.frame(id = 11:12,label = paste0("C", 1:2), group = "C"),
data.frame(id = 13,   label = "D1",             group = "D")
)
# Disposiciones aproximadas para forzar formas:
# A a lo largo de una diagonal:
posA <- cbind(seq(-300, -50, length.out = 6), seq(-200, 50, length.out = 6))
# B compacto:
posB <- cbind(jitter(rep(120,4), 30), jitter(c(-40, 20, 60, -80), 30))
# C casi alineado vertical:
posC <- cbind(rep(330,2), c(-70, 110))
# D aislado:
posD <- matrix(c(-20, 220), ncol=2)
coords <- rbind(posA, posB, posC, posD)
nodes$x <- coords[,1]; nodes$y <- coords[,2]
# Aristas intra e inter-grupo
edges <- rbind(
# intra
data.frame(from = c(1,2,3,4,5, 7,7,8,11), to = c(2,3,4,5,6, 8,9,10,12)),
# inter (conexiones cruzadas)
data.frame(from = c(2,6,9,12,13), to = c(7,11,1,10,8))
)
# Tamaño/color por grupo (opcional, para ver bien)
nodes$color <- c(rep("#6EA8FE",6), rep("#72D6A0",4), rep("#F7B267",2), "#D985B9")
nodes$borderWidth <- 1
nodes$shape <- "dot"
nodes$size <- 24
# ===== JS: hulls robustos con PCA para formas alargadas =====
# usa tu nodes/edges de siempre…
js_hulls <- "
function(ctx){
var net = this;
// ===== Parámetros =====
var PAD_SIDE = 36;   // separación lateral respecto a nodos
var ROUNDING = 0;    // 0 = sin curvas. Prueba 6–8 si quieres leve redondeo
var LINE_W   = 2;
// -------- utilidades --------
function uniqueGroups(){ var seen={}, arr=net.body.data.nodes.get();
arr.forEach(function(n){ if(n.group!=null) seen[n.group]=true; });
return Object.keys(seen);
}
function centroid(pts){ var cx=0,cy=0; for (var i=0;i<pts.length;i++){ cx+=pts[i].x; cy+=pts[i].y; }
return {x:cx/pts.length, y:cy/pts.length};
}
function convexHull(points){
if(points.length<=1) return points.slice();
var pts=points.slice().sort(function(a,b){ return a.x!==b.x ? a.x-b.x : a.y-b.y; });
function cross(o,a,b){ return (a.x-o.x)*(b.y-o.y)-(a.y-o.y)*(b.x-o.x); }
var lower=[], upper=[];
for(var i=0;i<pts.length;i++){ while(lower.length>=2 && cross(lower[lower.length-2], lower[lower.length-1], pts[i])<=0) lower.pop(); lower.push(pts[i]); }
for(var j=pts.length-1;j>=0;j--){ while(upper.length>=2 && cross(upper[upper.length-2], upper[upper.length-1], pts[j])<=0) upper.pop(); upper.push(pts[j]); }
upper.pop(); lower.pop(); return lower.concat(upper);
}
function isCCW(pts){ var s=0; for(var i=0;i<pts.length;i++){ var a=pts[i], b=pts[(i+1)%pts.length]; s+=a.x*b.y-a.y*b.x; } return s>0; }
function lineIntersect(p1,d1,p2,d2){ var det=d1.x*d2.y-d1.y*d2.x; if(Math.abs(det)<1e-9) return null;
var t=((p2.x-p1.x)*d2.y-(p2.y-p1.y)*d2.x)/det; return {x:p1.x+t*d1.x, y:p1.y+t*d1.y};
}
// offset convexo exterior puro (sin autointersecciones)
function offsetConvex(pts, dist){
if(pts.length<3) return null;
var H=pts.slice(); if(!isCCW(H)) H.reverse();
var N=H.length, out=new Array(N);
for(var i=0;i<N;i++){
var p0=H[(i-1+N)%N], p1=H[i], p2=H[(i+1)%N];
var e0={x:p1.x-p0.x,y:p1.y-p0.y}, e1={x:p2.x-p1.x,y:p2.y-p1.y};
var l0=Math.hypot(e0.x,e0.y)||1, l1=Math.hypot(e1.x,e1.y)||1; e0.x/=l0; e0.y/=l0; e1.x/=l1; e1.y/=l1;
var n0={x:e0.y,y:-e0.x}, n1={x:e1.y,y:-e1.x}; // exterior
var pB={x:p1.x+n0.x*dist,y:p1.y+n0.y*dist}, pC={x:p1.x+n1.x*dist,y:p1.y+n1.y*dist};
var q=lineIntersect(pB,e0,pC,e1);
out[i]= q ? q : {x:p1.x+(n0.x+n1.x)*dist, y:p1.y+(n0.y+n1.y)*dist};
}
return out;
}
function drawPoly(ctx, pts, styles){
if(!pts || pts.length<3) return;
ctx.save();
ctx.globalCompositeOperation='source-over';
ctx.lineJoin = ROUNDING>0 ? 'round' : 'miter';
ctx.lineCap  = 'round';
ctx.miterLimit = 2;
ctx.fillStyle = styles.fill; ctx.strokeStyle = styles.stroke; ctx.lineWidth = styles.lw;
if (ROUNDING<=0){
// polígono limpio, sin redondeo
ctx.beginPath(); ctx.moveTo(pts[0].x, pts[0].y);
for (var i=1;i<pts.length;i++) ctx.lineTo(pts[i].x, pts[i].y);
ctx.closePath(); ctx.fill(); ctx.stroke();
} else {
// redondeo leve mediante arcTo limitado
ctx.beginPath(); var n=pts.length;
for (var i=0;i<n;i++){
var p0=pts[(i-1+n)%n], p1=pts[i], p2=pts[(i+1)%n];
var v1x=p1.x-p0.x, v1y=p1.y-p0.y, v2x=p2.x-p1.x, v2y=p2.y-p1.y;
var l1=Math.hypot(v1x,v1y)||1, l2=Math.hypot(v2x,v2y)||1;
var rr=Math.min(ROUNDING,0.45*l1,0.45*l2); // limitar fuerte → evita curvar hacia dentro
v1x/=l1; v1y/=l1; v2x/=l2; v2y/=l2;
var p1_in ={x:p1.x-v1x*rr, y:p1.y-v1y*rr};
var p1_out={x:p1.x+v2x*rr, y:p1.y+v2y*rr};
if(i===0) ctx.moveTo(p1_in.x,p1_in.y); else ctx.lineTo(p1_in.x,p1_in.y);
ctx.arcTo(p1.x,p1.y,p1_out.x,p1_out.y,rr);
}
ctx.closePath(); ctx.fill(); ctx.stroke();
}
ctx.restore();
}
function drawLabel(ctx, pts, label, stroke){
var c = centroid(pts);
ctx.save();
ctx.font='14px sans-serif'; ctx.textAlign='center'; ctx.textBaseline='middle';
ctx.strokeStyle=stroke; ctx.lineWidth=4; ctx.strokeText(label,c.x,c.y);
ctx.fillStyle='rgba(0,0,0,0.85)'; ctx.fillText(label,c.x,c.y);
ctx.restore();
}
var colorMap={
'A': {fill:'rgba(110,168,254,0.15)', stroke:'rgba(110,168,254,0.65)', lw:LINE_W, label:'A'},
'B': {fill:'rgba(114,214,160,0.15)', stroke:'rgba(114,214,160,0.65)', lw:LINE_W, label:'B'},
'C': {fill:'rgba(247,178,103,0.15)', stroke:'rgba(247,178,103,0.65)', lw:LINE_W, label:'C'},
'D': {fill:'rgba(217,133,185,0.15)', stroke:'rgba(217,133,185,0.65)', lw:LINE_W, label:'D'}
};
var groups = uniqueGroups();
groups.forEach(function(g){
var ids = net.body.data.nodes.getIds({filter:function(n){return n.group===g;}});
if(!ids || ids.length===0) return;
var pos = net.getPositions(ids);
var pts = ids.map(function(id){ return {x:pos[id].x, y:pos[id].y}; });
var styles = colorMap[g] || {fill:'rgba(120,120,120,0.12)', stroke:'rgba(120,120,120,0.55)', lw:LINE_W, label:g};
// 1–2 nodos: rectángulo acolchado (sin redondeo para evitar curvas)
if(pts.length<=2){
var xs=pts.map(p=>p.x), ys=pts.map(p=>p.y);
var minX=Math.min.apply(null,xs)-PAD_SIDE, maxX=Math.max.apply(null,xs)+PAD_SIDE;
var minY=Math.min.apply(null,ys)-PAD_SIDE, maxY=Math.max.apply(null,ys)+PAD_SIDE;
var rect=[{x:minX,y:minY},{x:maxX,y:minY},{x:maxX,y:maxY},{x:minX,y:maxY}];
drawPoly(ctx, rect, styles); drawLabel(ctx, rect, styles.label, styles.fill);
return;
}
// offset convexo puro
var hull = convexHull(pts);
var off  = offsetConvex(hull, PAD_SIDE);
drawPoly(ctx, off, styles);
drawLabel(ctx, off, styles.label, styles.fill);
});
}
"
visNetwork(nodes, edges, width='100%', height='640px') |>
visOptions(highlightNearest=TRUE, nodesIdSelection=TRUE) |>
visInteraction(dragNodes=TRUE, dragView=TRUE, zoomView=TRUE) |>
visPhysics(stabilization=TRUE) |>
visEvents(beforeDrawing = js_hulls)
# install.packages("visNetwork")
library(visNetwork)
# ===== Datos de ejemplo "casi reales" =====
set.seed(3)
# Grupos: A (6 nodos, alargado), B (4 nodos), C (2 nodos), D (1 nodo)
nodes <- rbind(
data.frame(id = 1:6,  label = paste0("A", 1:6), group = "A"),
data.frame(id = 7:10, label = paste0("B", 1:4), group = "B"),
data.frame(id = 11:12,label = paste0("C", 1:2), group = "C"),
data.frame(id = 13,   label = "D1",             group = "D")
)
# Disposiciones aproximadas para forzar formas:
# A a lo largo de una diagonal:
posA <- cbind(seq(-300, -50, length.out = 6), seq(-200, 50, length.out = 6))
# B compacto:
posB <- cbind(jitter(rep(120,4), 30), jitter(c(-40, 20, 60, -80), 30))
# C casi alineado vertical:
posC <- cbind(rep(330,2), c(-70, 110))
# D aislado:
posD <- matrix(c(-20, 220), ncol=2)
coords <- rbind(posA, posB, posC, posD)
nodes$x <- coords[,1]; nodes$y <- coords[,2]
# Aristas intra e inter-grupo
edges <- rbind(
# intra
data.frame(from = c(1,2,3,4,5, 7,7,8,11), to = c(2,3,4,5,6, 8,9,10,12)),
# inter (conexiones cruzadas)
data.frame(from = c(2,6,9,12,13), to = c(7,11,1,10,8))
)
# Tamaño/color por grupo (opcional, para ver bien)
nodes$color <- c(rep("#6EA8FE",6), rep("#72D6A0",4), rep("#F7B267",2), "#D985B9")
nodes$borderWidth <- 1
nodes$shape <- "dot"
nodes$size <- 24
# ===== JS: hulls robustos con PCA para formas alargadas =====
# usa tu nodes/edges de siempre…
js_hulls <- "
function(ctx){
var net = this;
// ===== Parámetros =====
var PAD_SIDE = 36;   // separación lateral respecto a nodos
var ROUNDING = 8;    // 0 = sin curvas. Prueba 6–8 si quieres leve redondeo
var LINE_W   = 2;
// -------- utilidades --------
function uniqueGroups(){ var seen={}, arr=net.body.data.nodes.get();
arr.forEach(function(n){ if(n.group!=null) seen[n.group]=true; });
return Object.keys(seen);
}
function centroid(pts){ var cx=0,cy=0; for (var i=0;i<pts.length;i++){ cx+=pts[i].x; cy+=pts[i].y; }
return {x:cx/pts.length, y:cy/pts.length};
}
function convexHull(points){
if(points.length<=1) return points.slice();
var pts=points.slice().sort(function(a,b){ return a.x!==b.x ? a.x-b.x : a.y-b.y; });
function cross(o,a,b){ return (a.x-o.x)*(b.y-o.y)-(a.y-o.y)*(b.x-o.x); }
var lower=[], upper=[];
for(var i=0;i<pts.length;i++){ while(lower.length>=2 && cross(lower[lower.length-2], lower[lower.length-1], pts[i])<=0) lower.pop(); lower.push(pts[i]); }
for(var j=pts.length-1;j>=0;j--){ while(upper.length>=2 && cross(upper[upper.length-2], upper[upper.length-1], pts[j])<=0) upper.pop(); upper.push(pts[j]); }
upper.pop(); lower.pop(); return lower.concat(upper);
}
function isCCW(pts){ var s=0; for(var i=0;i<pts.length;i++){ var a=pts[i], b=pts[(i+1)%pts.length]; s+=a.x*b.y-a.y*b.x; } return s>0; }
function lineIntersect(p1,d1,p2,d2){ var det=d1.x*d2.y-d1.y*d2.x; if(Math.abs(det)<1e-9) return null;
var t=((p2.x-p1.x)*d2.y-(p2.y-p1.y)*d2.x)/det; return {x:p1.x+t*d1.x, y:p1.y+t*d1.y};
}
// offset convexo exterior puro (sin autointersecciones)
function offsetConvex(pts, dist){
if(pts.length<3) return null;
var H=pts.slice(); if(!isCCW(H)) H.reverse();
var N=H.length, out=new Array(N);
for(var i=0;i<N;i++){
var p0=H[(i-1+N)%N], p1=H[i], p2=H[(i+1)%N];
var e0={x:p1.x-p0.x,y:p1.y-p0.y}, e1={x:p2.x-p1.x,y:p2.y-p1.y};
var l0=Math.hypot(e0.x,e0.y)||1, l1=Math.hypot(e1.x,e1.y)||1; e0.x/=l0; e0.y/=l0; e1.x/=l1; e1.y/=l1;
var n0={x:e0.y,y:-e0.x}, n1={x:e1.y,y:-e1.x}; // exterior
var pB={x:p1.x+n0.x*dist,y:p1.y+n0.y*dist}, pC={x:p1.x+n1.x*dist,y:p1.y+n1.y*dist};
var q=lineIntersect(pB,e0,pC,e1);
out[i]= q ? q : {x:p1.x+(n0.x+n1.x)*dist, y:p1.y+(n0.y+n1.y)*dist};
}
return out;
}
function drawPoly(ctx, pts, styles){
if(!pts || pts.length<3) return;
ctx.save();
ctx.globalCompositeOperation='source-over';
ctx.lineJoin = ROUNDING>0 ? 'round' : 'miter';
ctx.lineCap  = 'round';
ctx.miterLimit = 2;
ctx.fillStyle = styles.fill; ctx.strokeStyle = styles.stroke; ctx.lineWidth = styles.lw;
if (ROUNDING<=0){
// polígono limpio, sin redondeo
ctx.beginPath(); ctx.moveTo(pts[0].x, pts[0].y);
for (var i=1;i<pts.length;i++) ctx.lineTo(pts[i].x, pts[i].y);
ctx.closePath(); ctx.fill(); ctx.stroke();
} else {
// redondeo leve mediante arcTo limitado
ctx.beginPath(); var n=pts.length;
for (var i=0;i<n;i++){
var p0=pts[(i-1+n)%n], p1=pts[i], p2=pts[(i+1)%n];
var v1x=p1.x-p0.x, v1y=p1.y-p0.y, v2x=p2.x-p1.x, v2y=p2.y-p1.y;
var l1=Math.hypot(v1x,v1y)||1, l2=Math.hypot(v2x,v2y)||1;
var rr=Math.min(ROUNDING,0.45*l1,0.45*l2); // limitar fuerte → evita curvar hacia dentro
v1x/=l1; v1y/=l1; v2x/=l2; v2y/=l2;
var p1_in ={x:p1.x-v1x*rr, y:p1.y-v1y*rr};
var p1_out={x:p1.x+v2x*rr, y:p1.y+v2y*rr};
if(i===0) ctx.moveTo(p1_in.x,p1_in.y); else ctx.lineTo(p1_in.x,p1_in.y);
ctx.arcTo(p1.x,p1.y,p1_out.x,p1_out.y,rr);
}
ctx.closePath(); ctx.fill(); ctx.stroke();
}
ctx.restore();
}
function drawLabel(ctx, pts, label, stroke){
var c = centroid(pts);
ctx.save();
ctx.font='14px sans-serif'; ctx.textAlign='center'; ctx.textBaseline='middle';
ctx.strokeStyle=stroke; ctx.lineWidth=4; ctx.strokeText(label,c.x,c.y);
ctx.fillStyle='rgba(0,0,0,0.85)'; ctx.fillText(label,c.x,c.y);
ctx.restore();
}
var colorMap={
'A': {fill:'rgba(110,168,254,0.15)', stroke:'rgba(110,168,254,0.65)', lw:LINE_W, label:'A'},
'B': {fill:'rgba(114,214,160,0.15)', stroke:'rgba(114,214,160,0.65)', lw:LINE_W, label:'B'},
'C': {fill:'rgba(247,178,103,0.15)', stroke:'rgba(247,178,103,0.65)', lw:LINE_W, label:'C'},
'D': {fill:'rgba(217,133,185,0.15)', stroke:'rgba(217,133,185,0.65)', lw:LINE_W, label:'D'}
};
var groups = uniqueGroups();
groups.forEach(function(g){
var ids = net.body.data.nodes.getIds({filter:function(n){return n.group===g;}});
if(!ids || ids.length===0) return;
var pos = net.getPositions(ids);
var pts = ids.map(function(id){ return {x:pos[id].x, y:pos[id].y}; });
var styles = colorMap[g] || {fill:'rgba(120,120,120,0.12)', stroke:'rgba(120,120,120,0.55)', lw:LINE_W, label:g};
// 1–2 nodos: rectángulo acolchado (sin redondeo para evitar curvas)
if(pts.length<=2){
var xs=pts.map(p=>p.x), ys=pts.map(p=>p.y);
var minX=Math.min.apply(null,xs)-PAD_SIDE, maxX=Math.max.apply(null,xs)+PAD_SIDE;
var minY=Math.min.apply(null,ys)-PAD_SIDE, maxY=Math.max.apply(null,ys)+PAD_SIDE;
var rect=[{x:minX,y:minY},{x:maxX,y:minY},{x:maxX,y:maxY},{x:minX,y:maxY}];
drawPoly(ctx, rect, styles); drawLabel(ctx, rect, styles.label, styles.fill);
return;
}
// offset convexo puro
var hull = convexHull(pts);
var off  = offsetConvex(hull, PAD_SIDE);
drawPoly(ctx, off, styles);
drawLabel(ctx, off, styles.label, styles.fill);
});
}
